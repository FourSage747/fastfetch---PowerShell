{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "__LOGO_PATH__",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    },
    "color": {
    	"1": "magenta"
    }
  },
  "display": {
    "separator": "  ",
    "percent": {
    	"type": 3
	},
	"bar": {
    		"char": {
        		"elapsed": "▰",
        		"total": "▱"
    		},
    		"width": 13
	},
  },
  "modules": [
    {
      "type": "title",
      "format": "Hey, \u001b[32m{user-name}\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[36m ┌──────── Hardware ────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[36m │─ CPU   "
    },
    {
      "type": "gpu",
      "key": "\u001b[36m │─ GPU   ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "\u001b[36m │─\u001b[36m RAM   ",
      "format": "{used} / {total} {percentage-bar} {percentage}"
    },
    {
      "type": "swap",
      "key": "\u001b[36m │─ SWAP  ",
      "format": "{used} / {total} {percentage-bar} {percentage}"
    },
    {
      "type": "disk",
      "key": "\u001b[36m │─ {mountpoint}   ",
      "format": "{size-used} / {size-total} {size-percentage-bar} {size-percentage}"
    },
    {
      "type": "custom",
      "format": "\u001b[36m └──────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m ┌──────── Session ─────────\u001b[0m"
    },
    {
      "type": "title",
      "key": "\u001b[33m │─\u001b[33m LOGIN ",
      "format": "{1}"
    },
    {
      "type": "custom",
      "format": "\u001b[33m └──────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[32m ┌────── Uptime / Date ─────\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[32m │─\u001b[32m UPTIME"
    },
    {
      "type": "datetime",
      "key": "\u001b[32m │─\u001b[32m DATE  "
    },
    {
      "type": "custom",
      "format": "\u001b[32m └──────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "No te preocupes soy el mas fuerte! \u001b[35m(the strongest one💪)\u001b[0m."
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}